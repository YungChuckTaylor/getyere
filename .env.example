# Public browser/build variables. Safe to expose in the client bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_WEB_PUSH_VAPID_PUBLIC_KEY
VITE_PUBLIC_APP_URL=https://getyere.com

# Server-only values: set these as Supabase Edge Function secrets, never as VITE_*.
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY in hosted Edge Functions.
# PUBLIC_APP_URL=https://getyere.com
# RESEND_API_KEY=server-only
# RESEND_FROM_EMAIL=Yere <reminders@your-verified-domain.ng>
# TWILIO_ACCOUNT_SID=server-only
# TWILIO_AUTH_TOKEN=server-only
# TWILIO_FROM_NUMBER=server-only
# VAPID_PUBLIC_KEY=YOUR_WEB_PUSH_VAPID_PUBLIC_KEY_MATCHING_VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=server-only
# VAPID_SUBJECT=mailto:hello@getyere.com
# YERE_CRON_SECRET=server-only
