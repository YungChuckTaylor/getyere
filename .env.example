# Public browser/build variables. Safe to expose in the client bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_WEB_PUSH_VAPID_PUBLIC_KEY
VITE_PUBLIC_APP_URL=https://getyere.com

# Vercel serverless admin guard/proxy values. These are public project settings, not service-role secrets.
# Set in Vercel as server-side variables (or rely on the VITE_* values above):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# The canonical origin is the apex https://getyere.com (vercel.json forwards getyere.vercel.app to it).
# The admin proxy accepts both https://getyere.com and https://www.getyere.com, and the native apps
# verify app links on both hosts.

# Server-only values: set these as Supabase Edge Function secrets, never as VITE_*.
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY in hosted Edge Functions.
# PUBLIC_APP_URL=https://getyere.com
# RESEND_API_KEY=server-only
# RESEND_FROM_EMAIL=Yere <reminders@your-verified-domain.ng>
# TWILIO_ACCOUNT_SID=server-only
# TWILIO_AUTH_TOKEN=server-only
# TWILIO_FROM_NUMBER=server-only
# VAPID_PUBLIC_KEY=YOUR_WEB_PUSH_VAPID_PUBLIC_KEY_MATCHING_VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=server-only
# VAPID_SUBJECT=mailto:hello@getyere.com
# YERE_CRON_SECRET=server-only

# Native push (server-only Supabase Edge Function secrets)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# APNS_KEY_ID=Apple-APNs-key-id
# APNS_TEAM_ID=Apple-developer-team-id
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# APNS_BUNDLE_ID=com.getyere.app
# APNS_USE_SANDBOX=false
