{
  "name": "yere-reminders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:native": "node scripts/validate-cloud-env.mjs --target native && vite build --mode native",
    "verify:bundle": "node scripts/verify-bundle.mjs dist",
    "verify:backend": "node scripts/verify-backend.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "android:debug": "npm run build:native && cap sync android && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:native && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "@capgo/capacitor-supabase": "^8.2.7",
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "linkedom": "^0.18.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
