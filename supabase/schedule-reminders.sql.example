-- Run this in the Supabase SQL editor after replacing the two placeholders.
-- The Edge Function compares this secret to YERE_CRON_SECRET; do not put it in VITE_* variables.
create extension if not exists pg_cron with schema pg_catalog;
create extension if not exists pg_net with schema extensions;

select vault.create_secret(
  'https://YOUR_PROJECT_REF.supabase.co/functions/v1/dispatch-reminders',
  'yere_dispatch_url'
);
select vault.create_secret(
  'REPLACE_WITH_THE_SAME_RANDOM_SECRET_SET_AS_YERE_CRON_SECRET',
  'yere_dispatch_secret'
);

select cron.unschedule(jobid)
from cron.job
where jobname = 'yere-reminder-dispatch';

select cron.schedule(
  'yere-reminder-dispatch',
  '* * * * *',
  $$
    select net.http_post(
      url := (select decrypted_secret from vault.decrypted_secrets where name = 'yere_dispatch_url'),
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'x-yere-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'yere_dispatch_secret')
      ),
      body := jsonb_build_object('scheduled_at', now())
    );
  $$
);
