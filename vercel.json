{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "getyere.vercel.app"
        }
      ],
      "destination": "https://getyere.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/termsofuse",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ios-guide.html",
      "destination": "/ios-release-guide.html"
    },
    {
      "source": "/ios-release-guide",
      "destination": "/ios-release-guide.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html"
    },
    {
      "source": "/termsofuse",
      "destination": "/terms.html"
    },
    {
      "source": "/admin-access",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/api/admin-shell"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin-shell"
    },
    {
      "source": "/admin-api/:function",
      "destination": "/api/admin-proxy?function=:function"
    }
  ],
  "functions": {
    "api/admin-shell.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/admin-access",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin-api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
